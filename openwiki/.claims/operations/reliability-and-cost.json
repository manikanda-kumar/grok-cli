    {
      "id": "claim_1d44046c82da4775a2ab305a381f36b7",
      "statement": "callOpenRouter makes up to 3 attempts against the OpenRouter chat completions endpoint; retryable conditions are HTTP 429, any status >= 500, and network failures surfacing as TypeError whose message contains \"fetch\", and a retryable condition that never succeeds throws the mapped lastError.",
      "evidence": [
        {
          "resource": "repo://src/openrouter.ts#L111-L161",
          "version": "repo-lines-v1:sha256:510c0939c17480ec9f9b5400cf7d1e54807cf72261498a0534ea09cf469d19d2:"
        }
      ]
    },
    {
      "id": "claim_41368060234045b29ea2a59d7bde4ece",
      "statement": "Retry backoff is 2^attempt * 1000ms (2s, 4s), but a server Retry-After header on a retryable response wins when larger via Math.max(backoff, seconds * 1000); the header is read through optional chaining so mocked responses without headers.get are safe.",
      "evidence": [
        {
          "resource": "repo://src/openrouter.ts#L163-L176",
          "version": "repo-lines-v1:sha256:b175aef167dd62c064c7c89797057ba424543223f7cd2aa74bb35d7fe55928e1:"
