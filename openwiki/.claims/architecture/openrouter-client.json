    {
      "id": "claim_cb2328340d764bf1ade13f64cc2a6a94",
      "statement": "mapOpenRouterError classifies failures in strict order: 401/403 → auth error, 402 → credits/quota error, 404 or tool-use text while tools were requested → 'Model does not support OpenRouter server tools' (checked before the model-unavailable branch, so a 404 with tool-use text maps to the server-tool message), 404 or model/endpoint text → 'Model unavailable', 429/>=500 → retryable provider error, else a generic fallback that preserves the provider detail; every branch produces an OpenRouterError carrying the HTTP status.",
      "evidence": [
