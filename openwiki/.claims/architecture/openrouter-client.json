    {
      "id": "claim_1a3382e961284cebb4ff2aac38bb5760",
      "statement": "callOpenRouter retries up to 3 attempts: retryable conditions are HTTP 429, status >= 500, or a fetch TypeError; backoff is 2^attempt * 1000ms (2s, 4s) with a Retry-After header (seconds) winning when larger; non-retryable statuses (401/403, 402, 404) fail fast; an invalid JSON body on a 200 response throws OpenRouterError('OpenRouter returned an invalid JSON response. Please retry.') with the parse error as cause without retrying; after three failed attempts the loop throws the last recorded error or a generic failure.",
      "evidence": [
        {
          "resource": "repo://src/openrouter.ts#L110-L156",
          "version": "repo-lines-v1:sha256:bf0a48a19c6ec375e850c14f7670cbaabe9b23d024e44ca854b27c2c00b9be9f:"
        },
