    {
      "id": "claim_bbf69e18dfc3455990cef1fd8d847db1",
      "statement": "callOpenRouter in src/openrouter.ts is the single OpenRouter chat.completions wrapper: cli.ts wires it into runMode as the ModeCaller at startup, so every pipeline mode (single-call, schema two-pass, multi, retrieve, deepresearch) performs its model HTTP requests through this one function. It POSTs to https://openrouter.ai/api/v1/chat/completions with Authorization Bearer (apiKey from OPENROUTER_API_KEY env or config file), Content-Type, and identity headers HTTP-Referer (config.siteUrl ?? repo URL) and X-Title (config.appName); a missing apiKey throws OpenRouterError before any network I/O.",
      "evidence": [
        {
          "resource": "repo://src/cli.ts#L14-L35",
          "version": "repo-lines-v1:sha256:21f9da94857511a6df5945a0503545724244ebae29d13f0311c16a889a072f81:"
